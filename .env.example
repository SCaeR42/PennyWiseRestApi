# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=pennywise
DB_USER=pennywise_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# JWT (HS256 requires a secret of at least 32 bytes)
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_TTL=900
JWT_REFRESH_TTL=86400

# Application
APP_ENV=production
APP_DEBUG=false
